{
  "expo": {
    "name": "ResQ",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/resq-logo.jpg",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/transparent-splash.png",
      "backgroundColor": "#042F2E",
      "resizeMode": "contain",
      "dark": {
        "image": "./assets/images/transparent-splash.png",
        "backgroundColor": "#042F2E"
      }
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/resq-logo.jpg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "splash": {
        "image": "./assets/images/transparent-splash.png",
        "backgroundColor": "#042F2E",
        "resizeMode": "contain",
        "dark": {
          "image": "./assets/images/transparent-splash.png",
          "backgroundColor": "#042F2E"
        }
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ki4kirra.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#042F2E",
          "image": "./assets/images/transparent-splash.png",
          "dark": {
            "backgroundColor": "#042F2E",
            "image": "./assets/images/transparent-splash.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow this app to save QR codes to your photo gallery.",
          "savePhotosPermission": "Allow this app to save QR codes to your photo gallery."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cec2f86a-c4e4-438c-ab9b-ee7b0f51eb81"
      },
      "googleClientId": "230211236022-a4vh6il2mkot1i0nng1tl17dtbat2b3b.apps.googleusercontent.com"
    }
  }
}
